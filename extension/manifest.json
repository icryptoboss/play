{
  "manifest_version": 3,
  "name": "Vega",
  "version": "0.5.2",
  "description": "Provider access and playback for Vega. Works automatically on web.vega-app.in, vega-app.in and localhost.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "alarms"
  ],
  "incognito": "spanning",
  "host_permissions": [
    "https://vega-app.in/*",
    "https://web.vega-app.in/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Vega",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://vega-app.in/*",
        "https://web.vega-app.in/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://vega-app.in/*",
        "https://web.vega-app.in/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
